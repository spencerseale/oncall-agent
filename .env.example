# Braintrust — tracing, prompt/scorer push, online scoring, Topics
BRAINTRUST_API_KEY=sk-...

# Model access. The OpenAI client points at the Braintrust AI proxy by default,
# so OPENAI_API_KEY may be the same value as BRAINTRUST_API_KEY.
# To hit OpenAI directly: set a real key and OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.braintrust.dev/v1/proxy

# Exa — external research (vendor status pages, error signatures, SRE writeups)
EXA_API_KEY=...

# Optional overrides
BRAINTRUST_PROJECT=oncall-agent

# Three model tiers, cheapest first. The orchestrator routes and attributes over
# tool results, so it runs the cheap tier; the correlation sub-agent ranks
# precedent; the remediation and validation sub-agents draft and test a change,
# which is where being confidently wrong costs a responder the most.
ONCALL_MODEL=gpt-4.1
ONCALL_SUBAGENT_MODEL=gpt-4o-mini
ONCALL_REASONING_MODEL=o3
ONCALL_REASONING_EFFORT=medium   # low | medium | high (validated at startup)

# Where the orchestrator system prompt comes from:
#   local      — the literal in src/oncall_agent/prompt_library.py (default)
#   braintrust — the version pushed by `make push-prompts`, editable in the UI
ONCALL_PROMPT_SOURCE=local

# Deployment identity — becomes trace tags (env:prod, agent:v1.0.0, ...)
ONCALL_ENV=prod                 # prod | staging | dev (validated at startup)
ONCALL_AGENT_VERSION=1.0.0      # defaults to the package version

# --- Tuning knobs, all optional --------------------------------------------
# Models used by the evaluation layer rather than the agent
ONCALL_JUDGE_MODEL=gpt-4o           # the three LLM-as-judge scorers
ONCALL_FACET_MODEL=gpt-4o-mini      # the three platform-facing Topics facets
# agent_failure_mode makes a negative judgment with a NONE default, which is
# harder than the other three facets' descriptive extraction. gpt-4o-mini
# false-positived on a good answer in testing; this one pays for a better model.
ONCALL_FAILURE_FACET_MODEL=gpt-4.1-mini
# How far back `make topics` walks when extracting facets. At 1d, a project with
# weeks of history never reaches enough labeled values to cluster. Cost is one
# extraction call per facet per trace in the window.
ONCALL_TOPICS_BACKFILL=30d

# Online scoring sampling rates (0-1), read by `make automations`.
# Lower readiness first under volume: most expensive judge, and a trend metric
# rather than an alarm. Leave safety and handoff at 1.0 — safety is a
# production-safety control, handoff is a code scorer with no model cost.
ONCALL_READINESS_SAMPLING=1.0
ONCALL_ACCURACY_SAMPLING=1.0
ONCALL_SAFETY_SAMPLING=1.0
ONCALL_HANDOFF_SAMPLING=1.0
# Defect Free is the failure-rate signal. Leave at 1.0: a rate estimated from a
# sample is a worse number, and the scorer costs nothing to run.
ONCALL_DEFECT_SAMPLING=1.0
# Retrieval Grounded is composition-sensitive — it fires on questions the agent
# cannot serve, so it tracks question mix. A trend to read per slice, not an alarm.
ONCALL_RETRIEVAL_SAMPLING=1.0

# Eval dataset name, shared by `make dataset`, `make experiment`, `make remote-eval`
ONCALL_EVAL_DATASET=oncall-agent-root-traces

# Cap on ReAct loop iterations before the agent stops asking for tools
ONCALL_MAX_TOOL_ITERATIONS=8
